CONFIG_SRAM_VECTOR_TABLE=y

# General Kernel Options
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=96000000
CONFIG_XIP=y

# GPIO Driver
CONFIG_GPIO=y

# UART Driver
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Console Driver
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Flash Driver
CONFIG_FLASH=y
CONFIG_FLASH_SHELL=y

# Watchdog Driver
CONFIG_WATCHDOG=y

# ADC Driver
CONFIG_ADC=y

# I2C Driver
CONFIG_I2C=y

# C2H Driver
CONFIG_C2H_NPCM=y

#I3C Driver
CONFIG_I3C=y
CONFIG_I3C_USE_IBI=y
CONFIG_I3C_SHELL=y

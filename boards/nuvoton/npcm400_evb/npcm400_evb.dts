/dts-v1/;

#include <nuvoton/npcm400.dtsi>

/ {
	model = "Nuvoton NPCM400 evaluation board";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,shell-uart = &uart1;
		zephyr,console = &uart1;
	};

	aliases {
		watchdog0 = &twd;
	};

	zephyr,user {
		/**
		 * Adjust channel number according to definition in npcm_adc.h.
		 *
		 * The following channels are shared with same pin, so they can't be selected at
		 * the same time. If no channel is selected, the pin defaults to VINx.
		 *  - VIN16, THR16, TD2P
		 *  - VIN15, THR15, TD1P
		 *  - VIN14, THR14, TD0P
		 *  - VIN1,  THR1,  TD3P
		 *  - VIN2,  THR2,  TD4P
		 *
		 * Example : If you select channel 6(VIN16),
		 *           and you can't select channel 7(THR16) and channel 19(TD2P).
		 */
		io-channels = <&dsadc NPCM_ADC_CH17_VTT>, <&dsadc NPCM_ADC_CH18_VBAT>;
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&cr_uart1_sin_sout_gpio14_15>;
	pinctrl-names = "default";
};

&uart2 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&cr_uart2_sin_sout_gpio30_31>;
	pinctrl-names = "default";
};

&dsadc {
	status = "okay";
	/* Pin D7 is shared by thermal signal VIN16, THR16, TD2P.
	 * Pin C7 is shared by thermal signal VIN15, THR15, TD1P.
	 * Pin A6 is shared by thermal signal VIN14, THR14, TD0P.
	 * Pin B6 is shared by thermal signal VIN1, THR1, TD3P.
	 * Pin C6 is shared by thermal signal VIN2, THR2, TD4P.
	 */
	pinctrl-0 = <&adc_vin7_gpio86   /* VIN7 - C8 */
			&adc_vin5_gpio87        /* VIN5 - F7 */
			&adc_vin16_gpio90       /* VIN16/THR16/TD2P - D7 */
			&adc_vin15_gpio91       /* VIN15/THR15/TD1P - C7 */
			&adc_vin14_gpio92       /* VIN14/THR14/TD0P - A6 */
			&adc_vin1_gpio93        /* VIN1/THR1/TD3P - B6 */
			&adc_vin2_gpio94        /* VIN2/THR2/TD4P - C6 */
			&adc_vin3_gpio95>;      /* VIN3 - D6 */
	pinctrl-names = "default";
};

&i2c1a {
	status = "okay";
	pinctrl-0 = <&i2c1a_scl_sda_gpio60_61>;
	pinctrl-names = "default";
	clock-frequency = <200000>;
	eeprom0: eeprom@54 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x54>;
		size = <1024>;
	};
};

&i2c3a {
	status = "okay";
	pinctrl-0 = <&i2c3a_scl_sda_gpioa7_a2>;
	pinctrl-names = "default";
	clock-frequency = <200000>;
	eeprom1: eeprom@56 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x56>;
		size = <1024>;
	};
};

&c2h {
	status = "okay";
};

&i3c1 {
	i3c-scl-hz = <12500000>;
	i3c-od-scl-hz = <4170000>;
	i2c-scl-hz = <1000000>;
	pinctrl-0 = <&i3c1_scl_sda_gpio21_22>;
	pinctrl-names = "default";
	status = "disabled";
};

&i3c2 {
	i3c-scl-hz = <12500000>;
	i3c-od-scl-hz = <4170000>;
	i2c-scl-hz = <1000000>;
	pinctrl-0 = <&i3c2_scl_sda_gpio23_24>;
	pinctrl-names = "default";
	status = "disabled";
};

&i3c3 {
	i3c-scl-hz = <12500000>;
	i3c-od-scl-hz = <4170000>;
	i2c-scl-hz = <1000000>;
	pinctrl-0 = <&i3c3_scl_sda_gpio26_25>;
	pinctrl-names = "default";
	status = "disabled";
};

&i3c4 {
	i3c-scl-hz = <12500000>;
	i3c-od-scl-hz = <4170000>;
	i2c-scl-hz = <1000000>;
	pinctrl-0 = <&i3c4_scl_sda_gpiod0_d1>;
	pinctrl-names = "default";
	status = "disabled";
};

&i3c5 {
	i3c-scl-hz = <12500000>;
	i3c-od-scl-hz = <4170000>;
	i2c-scl-hz = <1000000>;
	pinctrl-0 = <&i3c5_scl_sda_gpio82_83>;
	pinctrl-names = "default";
	status = "disabled";
};

&i3c6 {
	i3c-scl-hz = <12500000>;
	i3c-od-scl-hz = <4170000>;
	i2c-scl-hz = <1000000>;
	pinctrl-0 = <&i3c6_scl_sda_gpio96_97>;
	pinctrl-names = "default";
	status = "disabled";
};

&spip0 {
	pinctrl-0 = <&pspi1_clk_io0_io1_io2_io3_cs_gp66_67_70_73_76_77>;
	pinctrl-names = "default";
	status = "okay";
};

&qspi_fiu0 {
	ext_flash: w25q256jv@0 {
		compatible ="nuvoton,npcm-nor";
		size = <DT_SIZE_M(32 * 8)>;
		reg = <0>;
		enter-4byte-addr = <0xa5>;
		status = "okay";

		/* quad spi bus configuration of nor flash device */
		qspi-flags = <NPCM_QSPI_SW_CS1>;
		mapped-addr = <0x70000000>;
		pinctrl-0 = <&fiu0_shd_cs_io0_io1_clk_gp44_45_46_47
			     &fiu0_shd_quad_io2_io3_clk_gp55_56>;
		pinctrl-names = "default";
	};
};

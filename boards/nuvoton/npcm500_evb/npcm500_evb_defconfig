# General Kernel Options
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=96000000

# The Booter copies the image from the shared flash into Code RAM and jumps
# there, so nothing executes from flash. A Core Domain reset re-runs the
# Booter and reloads the image, so .data needs no separate load region to
# survive a reset.
CONFIG_XIP=n

# GPIO port driver
CONFIG_GPIO=y

# UART Driver
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Console Driver
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

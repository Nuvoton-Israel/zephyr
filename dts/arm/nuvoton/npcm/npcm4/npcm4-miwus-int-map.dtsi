/* Mapping between MIWU groups and interrupts */
&miwu0 {
	group_a0: group-a0-map {
		nuvoton,irq = <40>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x01>;
	};
	group_b0: group-b0-map {
		nuvoton,irq          = <41>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask   = <0x02>;
	};
	group_c0: group-c0-map {
		nuvoton,irq = <42>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x04>;
	};
	group_d0: group-d0-map {
		nuvoton,irq = <43>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x08>;
	};
	group_e0: group-e0-map {
		nuvoton,irq = <44>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x10>;
	};
	group_f0: group-f0-map {
		nuvoton,irq = <45>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x20>;
	};
	group_g0: group-g0-map {
		nuvoton,irq = <46>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x40>;
	};
	group_h0: group-h0-map {
		nuvoton,irq = <47>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x80>;
	};
};

&miwu1 {
	group_a1: group-a1-map {
		nuvoton,irq = <48>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x01>;
	};
	group_b1: group-b1-map {
		nuvoton,irq = <49>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x02>;
	};
	group_c1: group-c1-map {
		nuvoton,irq = <50>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x04>;
	};
	group_d1: group-d1-map {
		nuvoton,irq = <51>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x08>;
	};
	group_e1a: group-e1a-map {
		nuvoton,irq = <36>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x10>;
	};
	group_e1b: group-e1b-map {
		nuvoton,irq = <12>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x10>;
	};
	group_f1: group-f1-map {
		nuvoton,irq = <53>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x20>;
	};
	group_g1: group-g1-map {
		nuvoton,irq = <54>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x40>;
	};
	group_h1: group-h1-map {
		nuvoton,irq = <55>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x80>;
	};
};

&miwu2 {
	group_a2: group-a2-map {
		nuvoton,irq = <60>;
		nuvoton,irq-priority = <2>;
		nuvoton,group-mask = <0x01>;
	};
	group_b2: group-b2-map {

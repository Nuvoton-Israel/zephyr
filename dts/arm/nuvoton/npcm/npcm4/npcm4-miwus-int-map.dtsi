/* Mapping between GPIOs and MIWU groups */
&gpio0 {
	nuvoton,gpio-wui-maps = <NPCM_MIWU0_GROUPA_GPIO00
			NPCM_MIWU0_GROUPA_GPIO01
			NPCM_MIWU0_GROUPA_GPIO02
			NPCM_MIWU0_GROUPA_GPIO03

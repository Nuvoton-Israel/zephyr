config C2H_NPCM
	bool "NPCM core access to host modules driver"
	depends on DT_HAS_NUVOTON_NPCM_C2H_ENABLED
	help
	  This option enables the c2h driver for NPCM
	  SoCs.
	  Say y if you wish to access host modules
	  on NPCM SMC.

if C2H_NPCM
module = C2H_NPCM
module-str = c2h_npcm
source "subsys/logging/Kconfig.template.log_config"
endif
